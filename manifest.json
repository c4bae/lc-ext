{
  "manifest_version": 3,
  "name": "c4bae's lc ext",
  "version": "0.1.0",
  "description": "Submit NeetCode solutions to LeetCode. On Accepted, Claude quizzes you on your approach and complexity.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": ["https://neetcode.io/*", "https://leetcode.com/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://neetcode.io/*"],
      "js": ["lib/languages.js", "lib/slugs.js", "lib/bridge.js", "lib/toast.js", "lib/tooltip.js", "content/neetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://neetcode.io/*"],
      "js": ["content/neetcode-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["lib/languages.js", "lib/bridge.js", "lib/toast.js", "lib/tooltip.js", "content/leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/leetcode-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://neetcode.io/*", "https://leetcode.com/*"]
    }
  ]
}
